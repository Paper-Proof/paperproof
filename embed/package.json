{
  "name": "paperproof",
  "version": "0.1.2",
  "description": "Render Paperproof proof trees on any web page",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Paper-Proof/paperproof.git",
    "directory": "embed"
  },
  "type": "module",
  "main": "dist/paperproof-embed.js",
  "exports": {
    ".": "./dist/paperproof-embed.js",
    "./react": {
      "types": "./react.d.ts",
      "default": "./dist/react.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "jsdelivr": "dist/paperproof-embed.js",
  "unpkg": "dist/paperproof-embed.js",
  "bin": {
    "paperproof": "dist/cli.cjs"
  },
  "files": [
    "dist",
    "skill",
    "react.d.ts"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "keywords": [
    "paperproof",
    "proof",
    "mathematics",
    "lean",
    "lean4",
    "react"
  ],
  "devDependencies": {
    "esbuild": "0.19.12"
  },
  "sideEffects": [
    "./dist/paperproof-embed.js"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
